{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "pantrypal": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-builders/custom-webpack:browser",
          "options": {
            "customWebpackConfig": {
              "path": "./webpack.config.js"
            },
            "outputPath": "dist/pantrypal",
            "index": "src/index.html",
            "main": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/manifest.webmanifest"
            ],
            "serviceWorker": true,
            "extractLicenses": false,
            "ngswConfigPath": "ngsw-config.json",
            "styles": [
              "src/styles.scss"
            ],
            "polyfills": ["zone.js"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5mb",
                  "maximumError": "2mb"
                }
              ],
              "optimization": true,
              "outputHashing": "all"
            }
          }
        },
        "serve": {
          "builder": "@angular-builders/custom-webpack:dev-server",
          "options": {
            "buildTarget": "pantrypal:build"
          },
          "configurations": {
            "stable-live": {
              "liveReload": true,
              "watch": true,
              "hmr": false,
              "poll": 2000,
              "publicHost": "localhost:4200",
              "allowedHosts": [
                "localhost",
                "127.0.0.1"
              ],
              "forceEsbuild": true
            }
          }
        },
        "test": {
          "builder": "@analogjs/vitest-angular:test",
          "options": {
            "configFile": "vitest.config.mts"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "24a71072-30fa-4a57-b4e0-795ce00cc1eb"
  }
}

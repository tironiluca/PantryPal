{
  "name": "pantrypal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "start:stable": "ng serve --configuration stable-live",
    "build": "echo 'Node version:' && node -v && echo 'Starting Angular build...' && node --max-old-space-size=4096 node_modules/@angular/cli/bin/ng.js build --configuration production",
    "test": "ng test",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "postinstall": "cpy node_modules/sql.js/dist/sql-wasm.wasm src/assets/"
  },
  "dependencies": {
    "@angular/animations": "^20.3.16",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.16",
    "@angular/compiler": "^20.3.16",
    "@angular/core": "^20.3.16",
    "@angular/forms": "^20.3.16",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.16",
    "@angular/platform-browser-dynamic": "^20.3.16",
    "@angular/router": "^20.3.16",
    "@angular/service-worker": "^20.3.16",
    "@supabase/supabase-js": "^2.95.3",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/jspdf": "^1.3.3",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "fast-levenshtein": "^3.0.0",
    "idb": "^7.1.1",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "rxjs": "^7.8.1",
    "sql.js": "^1.10.2",
    "tesseract.js": "^4.1.1",
    "tslib": "^2.6.2",
    "zone.js": "^0.15.1"
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^20.0.0",
    "@angular-devkit/build-angular": "^20.3.16",
    "@angular/cli": "^20.3.16",
    "@angular/compiler-cli": "^20.3.16",
    "@types/sql.js": "^1.4.9",
    "baseline-browser-mapping": "^2.9.19",
    "cpy-cli": "^5.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}

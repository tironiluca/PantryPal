{
  "version": 2,
  "buildCommand": "NODE_OPTIONS=--max-old-space-size=4096 ng build --configuration production",
  "outputDirectory": "dist/pantrypal",
  "installCommand": "npm install --include=dev",
  "framework": null,
  "routes": [
    {
      "src": "/ngsw-worker.js",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/ngsw.json",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
